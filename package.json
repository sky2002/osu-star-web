{
  "name": "osu-star-web",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-side osu!mania 4K tree star v1 (P1h) reader",
  "type": "module",
  "scripts": {
    "test": "node tests/compare.mjs",
    "test:references": "node tests/dan-reference.mjs",
    "test:ladder": "node --test tests/acc-ladder.mjs",
    "test:items": "node tests/rice-ln-od.mjs",
    "test:mods": "node tests/compare_mods.mjs",
    "test:pattern-items": "node tests/compare_items.mjs --mode e2e",
    "build:tosu": "node tools/build-tosu.mjs",
    "test:dan": "node --test tests/dan-estimate.mjs",
    "test:tosu": "node tools/build-tosu.mjs && node --test tests/tosu-player.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "onnxruntime-web": "1.30.0"
  }
}
